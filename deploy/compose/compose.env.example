# Copy to .env for local smoke. Do not commit the copied file.
NETWORKCLAW_IMAGE=networkclaw:ci-linux-amd64
# Override if the Go checkout is named NetworkClaw or lives elsewhere:
# NETWORKCLAW_MIGRATIONS_DIR=/absolute/path/to/NetworkClaw/internal/lobby/database/migrations
POSTGRES_PASSWORD=replace-with-a-local-password
ONGRID_JWT_SECRET=replace-with-a-long-local-secret
ONGRID_OIDC_SECRET_KEY=replace-with-a-local-oidc-key
# Local-only default account: admin / admin. Override both values outside local smoke.
# Optional for a real provider turn:
# OPENAI_API_KEY=
# OPENAI_BASE_URL=https://api.openai.com/v1
# NETWORKCLAW_HARNESS_ALLOWED_EGRESS_HOSTS=api.openai.com
