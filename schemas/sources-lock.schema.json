{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://networkclaw.local/schemas/sources-lock.schema.json",
  "title": "NetworkClaw reproducible source combination",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "mode", "networkclaw", "harness", "integration", "protocol", "target"],
  "properties": {
    "schema_version": {"type": "integer", "const": 1},
    "mode": {"type": "string", "enum": ["checkout"]},
    "networkclaw": {"$ref": "#/$defs/source"},
    "harness": {"$ref": "#/$defs/source"},
    "integration": {"$ref": "#/$defs/source"},
    "protocol": {
      "type": "object", "additionalProperties": false, "required": ["version"],
      "properties": {"version": {"type": "string", "pattern": "^[0-9]+\\.[0-9]+$"}}
    },
    "target": {
      "type": "object", "additionalProperties": false, "required": ["os", "version", "architecture"],
      "properties": {
        "os": {"type": "string", "enum": ["ubuntu", "macos"]},
        "version": {"type": "string", "minLength": 1},
        "architecture": {"type": "string", "enum": ["amd64", "arm64"]}
      }
    }
  },
  "$defs": {
    "source": {
      "type": "object", "additionalProperties": false,
      "required": ["repository", "ref", "commit", "tree_sha256"],
      "properties": {
        "repository": {"type": "string", "minLength": 1},
        "ref": {"type": "string", "minLength": 1},
        "commit": {"type": "string", "minLength": 1},
        "tree_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"}
      }
    }
  }
}
