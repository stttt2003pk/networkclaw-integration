{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://networkclaw.local/schemas/events/event-envelope-v1.schema.json",
  "title": "NetworkClaw canonical event envelope v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["protocol_version", "type", "request_id", "sequence", "occurred_at", "payload", "end"],
  "properties": {
    "protocol_version": {"type": "string", "const": "1.0"},
    "type": {"type": "string", "minLength": 1, "pattern": "^[A-Za-z0-9_.-]+$"},
    "request_id": {"type": ["string", "null"], "minLength": 1},
    "sequence": {"type": "integer", "minimum": 1},
    "occurred_at": {"type": "string", "format": "date-time"},
    "end": {"type": "boolean"},
    "tenant_id": {"type": "string", "minLength": 1},
    "user_id": {"type": "string", "minLength": 1},
    "session_id": {"type": "string", "minLength": 1},
    "run_id": {"type": "string", "minLength": 1},
    "turn_id": {"type": "string", "minLength": 1},
    "trace_id": {"type": "string", "minLength": 1},
    "event_id": {"type": "string", "minLength": 1},
    "invocation_id": {"type": "string", "minLength": 1},
    "parent_item_id": {"type": "string", "minLength": 1},
    "interaction_id": {"type": "string", "minLength": 1},
    "artifact_id": {"type": "string", "minLength": 1},
    "cursor": {"type": "string", "minLength": 1},
    "metadata": {"type": "object", "additionalProperties": true},
    "payload": {"type": "object", "additionalProperties": true}
  },
  "allOf": [
    {"if": {"properties": {"type": {"pattern": "^((turn|assistant|tool|plan|subagent|delegation|artifact|clarification|approval|context|provider|usage|checkpoint|moa)(\\.|$)|subagent_progress$|grace\\.summary$|finalizer\\.fallback$)"}}}, "then": {"required": ["session_id", "run_id", "turn_id", "event_id"]}},
    {"if": {"required": ["session_id"]}, "then": {"required": ["event_id"]}}
  ]
}
